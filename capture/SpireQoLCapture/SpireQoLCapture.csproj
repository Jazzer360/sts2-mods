<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Capture helper for the Spire QoL site. Builds against the installed game (never commits its files)
    and is copied into <game>/mods only while capture.ps1 runs. It does nothing unless the game is
    started with the spireqol-capture argument (see the README).
  -->
  <PropertyGroup>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SpireQoLCapture</AssemblyName>
    <RootNamespace>SpireQoLCapture</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)\GodotSharp.dll" Private="false" />
    <None Include="SpireQoLCapture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckSts2Install" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')" Text="Couldn't find sts2.dll under '$(Sts2DataDir)'. Pass -p:Sts2Dir=&lt;your Slay the Spire 2 folder&gt;." />
  </Target>
</Project>
