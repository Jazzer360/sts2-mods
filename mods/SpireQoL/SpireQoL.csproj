<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsSts2Mod>true</IsSts2Mod>
    <!-- Must match "id" in SpireQoL.json: the game loads <id>.dll. -->
    <AssemblyName>SpireQoL</AssemblyName>
    <RootNamespace>SpireQoL</RootNamespace>
    <Version>1.7.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The settings check runs as a test before every release (tests/SpireQoL.Catalog.Tests). -->
    <InternalsVisibleTo Include="SpireQoL.Catalog.Tests" />
  </ItemGroup>
</Project>
