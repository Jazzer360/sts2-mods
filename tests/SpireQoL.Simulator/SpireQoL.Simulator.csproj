<Project Sdk="Microsoft.NET.Sdk">
  <!-- The outcome simulator (mods/SpireQoL/Sim, without the game-facing adapter) as an assembly of its own, for its tests: so coverage
       measures it and mutation testing (Stryker, decision #151) can change it. The mod compiles the same files into SpireQoL.dll;
       nothing here ships. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>SpireQoL</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every pure simulator file (no game types); the game-facing adapter (SimAdapter.cs, Adapter/) is left out. -->
    <Compile Include="..\..\mods\SpireQoL\Sim\**\*.cs" Exclude="..\..\mods\SpireQoL\Sim\Adapter\**\*.cs" LinkBase="Sim" />
    <!-- The event stream and the session counter (decision #108): pure C# too; the simulator posts its searches there. -->
    <Compile Include="..\..\mods\SpireQoL\Telemetry\**\*.cs" Exclude="..\..\mods\SpireQoL\Telemetry\SessionWatch.cs;..\..\mods\SpireQoL\Telemetry\DevDashboard.cs" LinkBase="Telemetry" />
    <InternalsVisibleTo Include="SpireQoL.Sim.Tests" />
  </ItemGroup>
</Project>
