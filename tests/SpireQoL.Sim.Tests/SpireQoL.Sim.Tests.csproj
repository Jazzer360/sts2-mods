<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the outcome simulator (mods/SpireQoL/Sim). The simulator has no game types, so these
       run without the game installed: `dotnet test tests/SpireQoL.Sim.Tests`. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every pure simulator file (no game types); the game-facing adapter (SimAdapter.cs, Adapter/) is left out. -->
    <Compile Include="..\..\mods\SpireQoL\Sim\**\*.cs" Exclude="..\..\mods\SpireQoL\Sim\SimAdapter.cs;..\..\mods\SpireQoL\Sim\Adapter\**\*.cs" LinkBase="Sim" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Cases/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Cases/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
