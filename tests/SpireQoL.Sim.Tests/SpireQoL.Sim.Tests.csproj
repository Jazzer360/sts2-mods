<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the outcome simulator (mods/SpireQoL/Sim). The simulator has no game types, so these
       run without the game installed: `dotnet test tests/SpireQoL.Sim.Tests`. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- The simulator, as its own assembly (decision #151): coverage measures it, Stryker mutates it. -->
    <ProjectReference Include="..\SpireQoL.Simulator\SpireQoL.Simulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Cases/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Cases/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The powers and relics modelled from their code, as the installed game's code reads them (the catalog tests write it: decision #195). -->
    <None Include="ReadModels/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
